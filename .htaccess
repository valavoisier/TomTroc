# Redirection de toutes les requêtes vers index.php pour traitement routeur
RewriteEngine on

# Exclure du routage les fichiers statics et dossiers existants (CSS, images, etc.)
# pour éviter recherche d'un fichier inexistant nommé PublicController par le système
# RewriteCond %{REQUEST_URI} !^/TomTroc/public/css/style.css$

# ne pas rediriger si le fichier éxiste
RewriteCond %{REQUEST_FILENAME} !-f

# ne pas rediriger si le dossier éxiste
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]